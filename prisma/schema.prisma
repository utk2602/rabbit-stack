generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model user {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  accounts      account[]
  repositories  repository[]
  sessions      session[]
  settings      settings?
}

model account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
}

model Test {
  id   String @id @default(cuid())
  name String
}

model repository {
  id            String             @id @default(cuid())
  githubId      Int                @unique
  name          String
  fullName      String
  description   String?
  url           String
  htmlUrl       String
  language      String?
  stars         Int                @default(0)
  forks         Int                @default(0)
  openIssues    Int                @default(0)
  isPrivate     Boolean            @default(false)
  isConnected   Boolean            @default(false)
  webhookId     Int?               // GitHub webhook ID for this repository
  webhookSecret String?            // Secret for verifying webhook payloads
  userId        String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  user          user               @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews       pullRequestReview[]

  @@index([userId])
  @@index([isConnected])
}

model pullRequestReview {
  id           String          @id @default(cuid())
  repositoryId String
  pullNumber   Int
  pullTitle    String
  pullUrl      String
  headSha      String
  baseBranch   String
  headBranch   String
  author       String
  status       String          @default("pending") // pending, in_progress, completed, failed
  summary      String?         @db.Text
  walkthrough  String?         @db.Text
  strengths    String[]
  issues       String[]
  suggestions  String[]
  poem         String?         @db.Text
  diagram      String?         @db.Text             // Mermaid sequence diagram
  rawMarkdown  String?         @db.Text             // Full raw response
  tokensUsed   Int?
  processingMs Int?                                 // Processing time in milliseconds
  error        String?         @db.Text
  postedToGithub Boolean       @default(false)
  githubReviewId Int?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  repository   repository      @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  comments     reviewComment[]

  @@unique([repositoryId, pullNumber, headSha])
  @@index([repositoryId])
  @@index([status])
}

model reviewComment {
  id         String            @id @default(cuid())
  reviewId   String
  path       String
  line       Int
  body       String            @db.Text
  severity   String            @default("info") // info, warning, error
  postedToGithub Boolean       @default(false)
  githubCommentId Int?
  createdAt  DateTime          @default(now())
  review     pullRequestReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

model settings {
  id                  String   @id @default(cuid())
  userId              String   @unique
  theme               String   @default("dark")
  emailNotifications  Boolean  @default(true)
  pushNotifications   Boolean  @default(false)
  language            String   @default("en")
  timezone            String   @default("UTC")
  publicProfile       Boolean  @default(true)
  showActivity        Boolean  @default(true)
  showRepositories    Boolean  @default(true)
  openaiApiKey        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
