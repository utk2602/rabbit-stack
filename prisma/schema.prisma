generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model user {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  accounts      account[]
  auditLogs     auditLog[]
  repositories  repository[]
  sessions      session[]
  settings      settings?
}

model account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model jwks {
  id         String    @id @default(cuid())
  publicKey  String
  privateKey String
  createdAt  DateTime
  expiresAt  DateTime?
}

model verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
}

model Test {
  id   String @id @default(cuid())
  name String
}

model repository {
  id            String             @id @default(cuid())
  githubId      Int
  name          String
  fullName      String
  description   String?
  url           String
  htmlUrl       String
  language      String?
  stars         Int                @default(0)
  forks         Int                @default(0)
  openIssues    Int                @default(0)
  isPrivate     Boolean            @default(false)
  isConnected   Boolean            @default(false)
  webhookId     Int?               // GitHub webhook ID for this repository
  webhookSecret String?            // Secret for verifying webhook payloads
  lastWebhookDeliveryId String?
  lastWebhookEvent      String?
  lastWebhookStatus     String?
  lastWebhookError      String?
  lastWebhookAt         DateTime?
  indexingStatus        String             @default("not_started")
  lastIndexedAt         DateTime?
  lastIndexError        String?            @db.Text
  indexedFileCount      Int                @default(0)
  indexedChunkCount     Int                @default(0)
  userId        String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  user          user               @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditLogs     auditLog[]
  reviewSettings repositoryReviewSettings?
  reviews       pullRequestReview[]

  @@index([userId])
  @@index([isConnected])
  @@index([lastWebhookStatus])
  @@index([indexingStatus])
  @@unique([userId, githubId])
}

model pullRequestReview {
  id           String          @id @default(cuid())
  repositoryId String
  pullNumber   Int
  pullTitle    String
  pullUrl      String
  headSha      String
  baseBranch   String
  headBranch   String
  author       String
  status       String          @default("pending") // pending, in_progress, completed, failed
  summary      String?         @db.Text
  walkthrough  String?         @db.Text
  strengths    String[]
  issues       String[]
  suggestions  String[]
  poem         String?         @db.Text
  diagram      String?         @db.Text             // Mermaid sequence diagram
  rawMarkdown  String?         @db.Text             // Full raw response
  tokensUsed   Int?
  processingMs Int?                                 // Processing time in milliseconds
  error        String?         @db.Text
  postedToGithub Boolean       @default(false)
  githubReviewId Int?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  repository   repository      @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  comments     reviewComment[]

  @@unique([repositoryId, pullNumber, headSha])
  @@index([repositoryId])
  @@index([status])
}

model reviewComment {
  id         String            @id @default(cuid())
  reviewId   String
  path       String
  line       Int
  body       String            @db.Text
  severity   String            @default("info") // info, warning, error
  postedToGithub Boolean       @default(false)
  githubCommentId Int?
  createdAt  DateTime          @default(now())
  review     pullRequestReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

model settings {
  id                  String   @id @default(cuid())
  userId              String   @unique
  theme               String   @default("dark")
  emailNotifications  Boolean  @default(true)
  pushNotifications   Boolean  @default(false)
  language            String   @default("en")
  timezone            String   @default("UTC")
  publicProfile       Boolean  @default(true)
  showActivity        Boolean  @default(true)
  showRepositories    Boolean  @default(true)
  openaiApiKey        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model auditLog {
  id           String      @id @default(cuid())
  userId       String?
  repositoryId String?
  event        String
  severity     String      @default("info")
  message      String
  metadata     Json?
  createdAt    DateTime    @default(now())
  user         user?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  repository   repository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([repositoryId])
  @@index([event])
  @@index([severity])
  @@index([createdAt])
}

model dependencyAudit {
  id              String   @id @default(cuid())
  source          String   @default("npm")
  total           Int      @default(0)
  critical        Int      @default(0)
  high            Int      @default(0)
  moderate        Int      @default(0)
  low             Int      @default(0)
  info            Int      @default(0)
  fixable         Int      @default(0)
  raw             Json
  createdAt       DateTime @default(now())

  @@index([source])
  @@index([createdAt])
}

model repositoryReviewSettings {
  id                    String     @id @default(cuid())
  repositoryId          String     @unique
  mode                  String     @default("balanced")
  minimumSeverityToPost String     @default("warning")
  customRules           String?    @db.Text
  useRepositoryRules    Boolean    @default(true)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  repository            repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([mode])
}
