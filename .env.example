DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
# Use https in production, for example https://rabbit-stack.vercel.app.
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional comma-separated host allowlist for Better Auth dynamic callback URLs.
BETTER_AUTH_ALLOWED_HOSTS="localhost:3000,127.0.0.1:3000"

GITHUB_CLIENT_ID="your-github-oauth-client-id"
GITHUB_CLIENT_SECRET="your-github-oauth-client-secret"

GOOGLE_GENERATIVE_AI_API_KEY="your-gemini-api-key"
PINECONE_API_KEY="your-pinecone-api-key"
PINECONE_INDEX_NAME="rabbit-stack"

# Recommended: keep this stable across deployments. If omitted, Rabbit Stack
# derives the token-encryption key from BETTER_AUTH_SECRET.
# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY="base64-encoded-32-byte-key"

# Required in production so GitHub can deliver webhooks.
WEBHOOK_URL="https://your-public-app.example.com"

# Local-only escape hatch for development without a public webhook URL.
ALLOW_LOCAL_WEBHOOK_BYPASS="false"

# Keep false unless you explicitly accept raw code snippets in Pinecone metadata.
PINECONE_STORE_CODE_SNIPPETS="false"

# Used by npm run reviews:prune.
REVIEW_RETENTION_DAYS="90"
